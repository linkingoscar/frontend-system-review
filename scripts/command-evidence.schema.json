{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:frontend-system-review:command-evidence:1.0",
  "title": "Frontend System Review Command Evidence",
  "type": "object",
  "required": ["schema_version", "label", "command", "cwd", "started_at", "duration_ms", "exit_code", "timed_out", "capture", "environment", "artifacts"],
  "properties": {
    "schema_version": { "const": "command-evidence-1.0" },
    "label": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,80}$" },
    "command": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "cwd": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "format": "date-time" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "exit_code": { "type": ["integer", "null"] },
    "timed_out": { "type": "boolean" },
    "capture": {
      "type": "object",
      "required": ["complete", "stdout_original_bytes", "stderr_original_bytes", "redactions_applied"],
      "properties": {
        "complete": { "type": "boolean" },
        "stdout_original_bytes": { "type": "integer", "minimum": 0 },
        "stderr_original_bytes": { "type": "integer", "minimum": 0 },
        "redactions_applied": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "environment": { "type": "object" },
    "artifacts": {
      "type": "object",
      "required": ["stdout", "stderr"],
      "properties": {
        "stdout": { "$ref": "#/$defs/artifact" },
        "stderr": { "$ref": "#/$defs/artifact" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
