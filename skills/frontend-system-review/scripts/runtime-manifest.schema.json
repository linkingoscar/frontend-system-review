{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/linkingoscar/frontend-system-review/blob/main/skills/frontend-system-review/scripts/runtime-manifest.schema.json",
  "title": "Frontend System Review runtime manifest",
  "type": "object",
  "required": ["routes"],
  "additionalProperties": false,
  "properties": {
    "viewports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/viewport" } },
    "waitUntil": { "enum": ["commit", "domcontentloaded", "load", "networkidle"] },
    "waitMs": { "type": "number", "minimum": 0 },
    "timeoutMs": { "type": "number", "minimum": 0 },
    "colorScheme": { "enum": ["light", "dark", "no-preference"] },
    "reducedMotion": { "enum": ["reduce", "no-preference"] },
    "budgets": { "$ref": "#/$defs/budgets" },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/route" }
    }
  },
  "$defs": {
    "viewport": {
      "type": "object",
      "required": ["name", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "isMobile": { "type": "boolean" },
        "hasTouch": { "type": "boolean" }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lcpMs": { "type": "number", "minimum": 0 },
        "cls": { "type": "number", "minimum": 0 },
        "transferSize": { "type": "number", "minimum": 0 },
        "resourceCount": { "type": "number", "minimum": 0 },
        "longTaskTotalMs": { "type": "number", "minimum": 0 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selector": { "type": "string", "minLength": 1 },
        "testId": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "placeholder": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "exact": { "type": "boolean" }
      },
      "oneOf": [
        { "required": ["selector"] },
        { "required": ["testId"] },
        { "required": ["role"] },
        { "required": ["label"] },
        { "required": ["placeholder"] },
        { "required": ["text"] }
      ]
    },
    "waitFor": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": { "$ref": "#/$defs/target" },
        "state": { "enum": ["attached", "detached", "visible", "hidden"] },
        "timeoutMs": { "type": "number", "minimum": 0 }
      }
    },
    "step": {
      "type": "object",
      "required": ["id", "action"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "action": { "enum": ["click", "fill", "press", "select", "check", "uncheck", "hover", "wait-for", "goto", "reload", "wait"] },
        "target": { "$ref": "#/$defs/target" },
        "value": { "type": ["string", "number"] },
        "valueEnv": { "type": "string", "minLength": 1 },
        "option": {},
        "key": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "state": { "enum": ["attached", "detached", "visible", "hidden"] },
        "waitFor": { "$ref": "#/$defs/waitFor" },
        "waitMs": { "type": "number", "minimum": 0 },
        "timeoutMs": { "type": "number", "minimum": 0 }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id", "steps"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "reset": { "type": "boolean" },
        "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
      }
    },
    "route": {
      "type": "object",
      "required": ["id", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "viewports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/viewport" } },
        "waitUntil": { "enum": ["commit", "domcontentloaded", "load", "networkidle"] },
        "waitMs": { "type": "number", "minimum": 0 },
        "timeoutMs": { "type": "number", "minimum": 0 },
        "budgets": { "$ref": "#/$defs/budgets" },
        "scenarios": { "type": "array", "items": { "$ref": "#/$defs/scenario" } }
      }
    }
  }
}
